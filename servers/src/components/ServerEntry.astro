---
import {
  fetchServerStatus,
  type ServerStatus,
} from "../scripts/servers/info";
import type { Server } from "../scripts/servers/utils";

interface Props {
  server: Server;
  serverStatus?: boolean;
}

const { server } = Astro.props;
let serverStatus: ServerStatus | undefined | null = undefined;
if (Astro.props.serverStatus) {
  serverStatus = await fetchServerStatus(server);
}

function buildJoinURL(): string {
  return `https://launch.setonix.linwood.dev/connect?address=${encodeURIComponent(server.address)}&secure=${encodeURIComponent(server.secure !== false)}`;
}

const isSecure = server.secure !== false;
const secureLabel = isSecure ? "Secure server" : "Unsecure server";
const statusLabel = serverStatus === undefined
  ? "Checking"
  : serverStatus === null
    ? "Offline"
    : "Online";
const playerText = serverStatus
  ? serverStatus.currentPlayers +
    (serverStatus.maxPlayers == null ? "" : `/${serverStatus.maxPlayers}`)
  : undefined;
const thumbnail = serverStatus?.hasThumbnail
  ? `/thumbnail?address=${encodeURIComponent(server.address)}&secure=${encodeURIComponent(isSecure)}`
  : undefined;
---

<li role="listitem">
  <a
    class:list={[
      "card",
      server.highlighted ? "primary" : "secondary",
      "gap-xs",
    ]}
    href={buildJoinURL()}
    target="_blank"
    rel="noopener"
    aria-label={`Connect to ${server.address}. ${statusLabel}. ${secureLabel}.`}
  >
    {thumbnail && (
      <img
        class="server-thumbnail"
        src={thumbnail}
        alt=""
        loading="lazy"
        decoding="async"
      />
    )}
    <div class="row gap-xs justify-between align-start">
      <p class="h3">{server.address}</p>
      <div class="row gap-xs align-center wrap justify-end" aria-live="polite">
        <p class:list={["bold", "m-none", serverStatus ? "primary" : "text"]}>
          {statusLabel}
        </p>
        {playerText && (
          <p class="bold m-none">
            {playerText}
          </p>
        )}
        <span
          role="img"
          aria-label={secureLabel}
          title={secureLabel}
        >
          {isSecure ? "🔒" : "🔓"}
        </span>
      </div>
    </div>

    <p class="text">
      {serverStatus === undefined
        ? "Loading…"
        : serverStatus?.description || "No description available."}
    </p>
    <div class="row gap-xs wrap">
      {server.highlighted && <span class="highlight">Highlighted</span>}
      {server.remote && <span class="text">Remote source</span>}
    </div>
  </a>
</li>

<style>
  .server-thumbnail {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 0.5rem;
    background: var(--ls-background-secondary);
  }
</style>
